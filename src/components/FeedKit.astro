---
import { getFeedPath } from 'astro-feed-kit'
import config from 'virtual:astro-feed-kit/config'

type Props = {
	/**
	 * Override the link `title` attribute used in the generated `<link
	 * rel="alternate">` tags. Defaults to `feedOptions.title`.
	 */
	title?: string
}

const { title } = Astro.props
const feedTitle = title ?? config.feedOptions.title

const rssPath = getFeedPath(config, 'rss')
const atomPath = getFeedPath(config, 'atom')
const jsonPath = getFeedPath(config, 'json')
---

{
	rssPath !== undefined && (
		<link href={rssPath} rel="alternate" title={feedTitle} type="application/rss+xml" />
	)
}
{
	atomPath !== undefined && (
		<link href={atomPath} rel="alternate" title={feedTitle} type="application/atom+xml" />
	)
}
{
	jsonPath !== undefined && (
		<link href={jsonPath} rel="alternate" title={feedTitle} type="application/feed+json" />
	)
}
