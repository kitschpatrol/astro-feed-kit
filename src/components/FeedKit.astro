---
import config from 'virtual:astro-feed-kit/config'

type Props = {
	/**
	 * Override the link `title` attribute used in the generated `<link
	 * rel="alternate">` tags. Defaults to `feedOptions.title`.
	 */
	title?: string
}

const { title } = Astro.props
const feedTitle = title ?? config.feedOptions.title
const { feedLinks } = config.feedOptions
---

{
	feedLinks?.rss && (
		<link href={feedLinks.rss} rel="alternate" title={feedTitle} type="application/rss+xml" />
	)
}
{
	feedLinks?.atom && (
		<link href={feedLinks.atom} rel="alternate" title={feedTitle} type="application/atom+xml" />
	)
}
{
	feedLinks?.json && (
		<link href={feedLinks.json} rel="alternate" title={feedTitle} type="application/feed+json" />
	)
}
