---
import { getFeedPath, localizeConfig } from 'astro-feed-kit'
import config from 'virtual:astro-feed-kit/config'

type Props = {
	/**
	 * Which locale's feeds to link to on a site with `i18n: true`. Defaults to
	 * `Astro.currentLocale`, falling back to the default locale. Ignored when
	 * `i18n` is off.
	 */
	locale?: string
	/**
	 * Override the link `title` attribute used in the generated `<link
	 * rel="alternate">` tags. Defaults to `feedOptions.title`.
	 */
	title?: string
}

const { locale, title } = Astro.props
const localized = localizeConfig(config, locale ?? Astro.currentLocale)
const feedTitle = title ?? localized.feedOptions.title

const rssPath = getFeedPath(localized, 'rss')
const atomPath = getFeedPath(localized, 'atom')
const jsonPath = getFeedPath(localized, 'json')
---

{rssPath !== undefined && (
	<link href={rssPath} rel="alternate" title={feedTitle} type="application/rss+xml" />
)}
{atomPath !== undefined && (
	<link href={atomPath} rel="alternate" title={feedTitle} type="application/atom+xml" />
)}
{jsonPath !== undefined && (
	<link href={jsonPath} rel="alternate" title={feedTitle} type="application/feed+json" />
)}
