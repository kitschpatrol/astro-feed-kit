{
	"name": "astro-feed-kit",
	"version": "0.4.1",
	"description": "Astro integration for full-content RSS, Atom, and JSON feeds.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"rss",
		"atom",
		"mdx",
		"json-feed",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-feed-kit",
	"bugs": "https://github.com/kitschpatrol/astro-feed-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-feed-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/FeedKit.astro": "./src/components/FeedKit.astro"
	},
	"files": [
		"dist",
		"src/components"
	],
	"scripts": {
		"bench": "vitest bench --run --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --outputJson test/benchmarks/baseline.json",
		"build": "tsdown && pnpm run -r astro sync",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "pnpm -C playground run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepublishOnly": "tsdown",
		"release": "bumpp --commit 'Release: %s' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"feed": "^6.0.0",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.10",
		"@kitschpatrol/shared-config": "^8.7.0",
		"@types/hast": "3.0.5",
		"@types/node": "~24.13.3",
		"astro": "^7.2.7",
		"bumpp": "^12.2.1",
		"defuddle": "^0.19.3",
		"hast-util-sanitize": "5.0.2",
		"linkedom": "^0.18.13",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.0.1",
		"shx": "^0.4.0",
		"tsdown": "^0.22.14",
		"typescript": "~6.0.3",
		"vite": "^8.2.2",
		"vitest": "^4.1.11"
	},
	"peerDependencies": {
		"astro": "^7.0.0"
	},
	"packageManager": "pnpm@11.18.0",
	"engines": {
		"node": ">=24.16.0"
	}
}
