{
	"name": "astro-feed-kit",
	"version": "0.6.0",
	"description": "Astro integration for full-content RSS, Atom, and JSON feeds.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"rss",
		"atom",
		"mdx",
		"json-feed",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-feed-kit",
	"bugs": "https://github.com/kitschpatrol/astro-feed-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-feed-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": false,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/FeedKit.astro": "./src/components/FeedKit.astro"
	},
	"files": [
		"dist",
		"src/components"
	],
	"scripts": {
		"bench": "vitest bench --run",
		"bench:baseline": "vitest bench --run --mode baseline",
		"build": "tsdown && pnpm run -r astro sync",
		"clean-deep": "shx rm -f pnpm-lock.yaml && git clean -fdX",
		"dev": "pnpm -C playground run dev",
		"dev-i18n": "pnpm -C playground-i18n run dev",
		"dev-starlight": "pnpm -C playground-starlight run dev",
		"fix": "ksc fix",
		"lint": "ksc lint",
		"prepare": "astro sync && pnpm run build",
		"prepublishOnly": "tsdown",
		"release": "bumpp --commit 'Release: %s' --all --execute 'chagent --root-changelog package --skip-package playground*' && pnpm build && pnpm publish --otp $(op item get npm --otp)",
		"test": "vitest run"
	},
	"dependencies": {
		"feed": "^6.0.0",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "5.2.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.12",
		"@kitschpatrol/chagent": "0.5.0",
		"@kitschpatrol/shared-config": "^8.14.1",
		"@types/hast": "3.0.5",
		"@types/node": "~24.13.6",
		"astro": "^7.4.7",
		"bumpp": "^12.3.0",
		"defuddle": "^0.19.6",
		"hast-util-sanitize": "5.0.2",
		"linkedom": "^0.18.15",
		"node-addon-api": "^8.9.2",
		"node-gyp": "^13.1.0",
		"shx": "^0.4.0",
		"tsdown": "^0.23.7",
		"typescript": "~6.0.3",
		"vite": "^8.3.6",
		"vitest": "^5.1.0"
	},
	"peerDependencies": {
		"astro": "^7.3.6"
	},
	"packageManager": "pnpm@12.18.0",
	"engines": {
		"node": "^24.16.0 || >=26.3.0"
	}
}
