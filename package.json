{
	"name": "astro-feed-kit",
	"version": "0.2.1",
	"description": "Astro integration for full-content RSS, Atom, and JSON feeds.",
	"keywords": [
		"astro",
		"astro-integration",
		"astro-component",
		"rss",
		"atom",
		"mdx",
		"json-feed",
		"npm-package"
	],
	"homepage": "https://github.com/kitschpatrol/astro-feed-kit",
	"bugs": "https://github.com/kitschpatrol/astro-feed-kit/issues",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/kitschpatrol/astro-feed-kit.git"
	},
	"license": "MIT",
	"author": {
		"name": "Eric Mika",
		"email": "eric@ericmika.com",
		"url": "https://ericmika.com"
	},
	"sideEffects": true,
	"type": "module",
	"exports": {
		".": {
			"types": "./dist/index.d.ts",
			"import": "./dist/index.js"
		},
		"./components/FeedKit.astro": "./src/components/FeedKit.astro"
	},
	"files": [
		"dist",
		"src/components"
	],
	"scripts": {
		"bench": "vitest bench --run --compare test/benchmarks/baseline.json",
		"bench:baseline": "vitest bench --run --outputJson test/benchmarks/baseline.json",
		"build": "tsdown && pnpm astro sync && pnpm run -r astro sync",
		"clean": "shx rm -f pnpm-lock.yaml && git clean -fdX -e !.claude/",
		"dev": "pnpm run play",
		"fix": "ksc fix",
		"lint": "ksc lint && pnpm run -r --include-workspace-root astro check",
		"play": "pnpm -C playground run dev",
		"play-starlight": "pnpm -C playground-starlight run dev",
		"prepublishOnly": "tsdown",
		"release": "bumpp --commit 'Release: %s' && pnpm build && NPM_AUTH_TOKEN=$(op read 'op://Personal/npm/token') pnpm publish",
		"test": "vitest run"
	},
	"dependencies": {
		"feed": "^5.2.1",
		"rehype-raw": "7.0.0",
		"rehype-sanitize": "6.0.0",
		"rehype-stringify": "10.0.1",
		"remark-gfm": "4.0.1",
		"remark-parse": "^11.0.0",
		"remark-rehype": "11.1.2",
		"unified": "^11.0.5",
		"unist-util-visit": "5.1.0"
	},
	"devDependencies": {
		"@astrojs/check": "^0.9.9",
		"@kitschpatrol/shared-config": "^7.6.0",
		"@types/hast": "3.0.4",
		"@types/node": "~24.12.4",
		"astro": "^6.3.3",
		"bumpp": "^11.1.0",
		"defuddle": "^0.18.1",
		"hast-util-sanitize": "5.0.2",
		"linkedom": "^0.18.12",
		"node-addon-api": "^8.7.0",
		"node-gyp": "^12.3.0",
		"shx": "^0.4.0",
		"tsdown": "^0.22.0",
		"typescript": "~6.0.3",
		"vite": "^7.3.3",
		"vitest": "^4.1.6"
	},
	"peerDependencies": {
		"astro": "^6.0.0"
	},
	"packageManager": "pnpm@11.1.2",
	"engines": {
		"node": ">=22.12.0"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": ">=24.12.0"
		}
	}
}
