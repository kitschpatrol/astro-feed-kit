---
import { getCollection } from 'astro:content'
import Layout from '../layouts/Layout.astro'

const posts = await getCollection('posts')
const notes = await getCollection('notes')

type Entry = { collection: string; date: Date; id: string; title: string }

const merged: Entry[] = [
	...posts.map((p) => ({
		collection: 'posts',
		date: p.data.date,
		id: p.id,
		title: p.data.title,
	})),
	...notes.map((n) => ({
		collection: 'notes',
		date: n.data.date,
		id: n.id,
		title: n.data.title,
	})),
].toSorted((a, b) => b.date.getTime() - a.date.getTime())
---

<Layout title="astro-feed-kit playground">
	<h1>astro-feed-kit playground</h1>

	<h2>Feeds</h2>
	<ul>
		<li><a href="/rss.xml">/rss.xml</a></li>
		<li><a href="/atom.xml">/atom.xml</a></li>
		<li><a href="/feed.json">/feed.json</a></li>
	</ul>

	<h2>Entries</h2>
	<ul>
		{
			merged.map((entry) => (
				<li>
					<code>{entry.collection}</code> · <strong>{entry.title}</strong> ·{' '}
					<time datetime={entry.date.toISOString()}>{entry.date.toISOString().slice(0, 10)}</time>
				</li>
			))
		}
	</ul>
</Layout>
